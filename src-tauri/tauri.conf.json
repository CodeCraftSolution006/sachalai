{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SachalAI",
  "version": "0.1.0",
  "identifier": "com.sachal.ai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SachalAI",
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": false,
        "backgroundColor": "#071330"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "shortDescription": "SachalAI — Groq-powered desktop assistant",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVFQ0I1ODA0NjZBQzQ3N0IKUldSN1I2eG1CRmpMN3U5cnUvbFFRUU45T2VKU1FoZ3k3SW9XV1c1VmtTbHhyWmZJSWJuQVhQeDgK",
      "endpoints": [
        "https://github.com/CodeCraftSolution006/sachalai/releases/latest/download/latest.json"
      ]
    }
  }
}
